---
import { withBase } from "../../lib/url";
import { site } from "../../content/site";
---

<section class="bg-brand-strong text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-14">
    <div>
      <h2 class="display-expanded text-2xl md:text-3xl">{site.fulfilmentBand.title}</h2>
      <p class="mt-2 max-w-[60ch] opacity-95">
        {site.fulfilmentBand.body}
      </p>
    </div>
    <a href={withBase(site.fulfilmentBand.ctaHref)} class="rounded-card bg-signal px-6 py-3 font-semibold text-ink transition-colors duration-200 hover:bg-signal-strong">{site.fulfilmentBand.ctaLabel}</a>
  </div>
</section>
